# ─── Skillfyme Platform — Root .env.example ──────────────────────────────────
# Copy this file to .env in each service directory and fill in your values.
# DO NOT commit .env files with real secrets to version control.

# ─── Infrastructure ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb://skillfyme:skillfyme_secret@localhost:27017/skillfyme?authSource=admin
DATABASE_URL=postgresql://skillfyme:skillfyme_secret@localhost:5432/skillfyme
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
ELASTICSEARCH_URL=http://localhost:9200

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_use_a_64char_random_string_in_production

# ─── Service URLs (for ui-backend) ───────────────────────────────────────────
COURSE_CATALOG_URL=http://localhost:9101
LEARNING_PATH_URL=http://localhost:9102
ASSESSMENT_ENGINE_URL=http://localhost:9103
LIVE_SESSION_URL=http://localhost:9104
CREDITS_CURRENCY_URL=http://localhost:9105
ENROLLMENT_URL=http://localhost:9106
PAYMENT_URL=http://localhost:9107
NOTIFICATION_URL=http://localhost:9108

# ─── Payment ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME

# ─── Notification ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
FROM_EMAIL=noreply@skillfyme.com

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000
